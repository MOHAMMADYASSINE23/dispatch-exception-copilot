// Dispatch Exception CoPilot — Prisma schema
// Enforces a strict taxonomy for courier shipment exceptions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShipmentStatus {
  DISPATCHED
  IN_TRANSIT
  HALTED
  DELIVERED
}

enum Severity {
  LOW
  HIGH
  CRITICAL
}

enum Category {
  VEHICLE_ISSUE
  CUSTOMER_ABSENT
  WEATHER
}

model Shipment {
  id              String         @id @default(uuid())
  trackingNumber  String         @unique
  customerName    String
  destinationCity String
  status          ShipmentStatus @default(DISPATCHED)
  exceptions      Exception[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Exception {
  id               String   @id @default(uuid())
  shipmentId       String
  shipment         Shipment @relation(fields: [shipmentId], references: [id])
  severity         Severity
  category         Category
  resolved         Boolean  @default(false)
  rawInput         String
  actionPlan       String
  notificationText String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
