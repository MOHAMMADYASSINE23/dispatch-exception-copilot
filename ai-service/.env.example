# Copy to .env for local development. Never commit real credentials.
# Shared bearer secret. Keep the same value in web-app/.env and this service.
AI_SERVICE_API_KEY=change-me-local-secret

# Optional: without this, the deterministic keyword fallback is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=7.0
OPENAI_MAX_TOKENS=1500

ENABLE_KEYWORD_FALLBACK=true
DEMO_FAIL_HOOK=true
